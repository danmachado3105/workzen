# Desenvolvimento com Docker: postgresql://usuario:senha@db:5432/nome_do_banco
# Produção: use uma URL PostgreSQL gerenciada com SSL quando o provedor exigir.
DATABASE_URL=postgresql://usuario:senha@db:5432/nome_do_banco
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
POSTGRES_DB=nome_do_banco
# Gere uma chave aleatória longa e exclusiva por ambiente. Nunca use este valor de exemplo.
SECRET_KEY=uma-chave-secreta-aleatoria-e-longa
# Desenvolvimento: http://localhost:5173,http://127.0.0.1:5173
# Produção: https://app.seu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
